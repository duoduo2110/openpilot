From 29984d9164e2137cf06cfbd272d58a30a6305b83 Mon Sep 17 00:00:00 2001
From: exp <exp@local>
Date: Tue, 25 Aug 2026 19:53:44 +0800
Subject: [PATCH 1/2] K1: bypass gcc-wrapper.py (python2 unavailable on build
 host)

---
 Makefile | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Makefile b/Makefile
index 43a123ab..dd895d95 100644
--- a/Makefile
+++ b/Makefile
@@ -366,7 +366,7 @@ CHECK		= sparse
 
 # Use the wrapper for the compiler.  This wrapper scans for new
 # warnings and causes the build to stop upon encountering them
-CC		= $(srctree)/scripts/gcc-wrapper.py $(REAL_CC)
+CC		= $(REAL_CC)
 
 CHECKFLAGS     := -D__linux__ -Dlinux -D__STDC__ -Dunix -D__unix__ \
 		  -Wbitwise -Wno-return-void $(CF)
-- 
2.34.1


